#!/usr/bin/env bash
# Docker mühitinə uyğun və shellcheck standartlarında hosts faylını yeniləyir

# 1. localhost hissəsini dəyişirik (cat yoxdur, sed faylı birbaşa oxuyur)
sed 's/127.0.0.1\tlocalhost/127.0.0.2\tlocalhost/g' /etc/hosts | sed 's/127.0.0.1 localhost/127.0.0.2 localhost/g' > /etc/hosts.tmp
mv /etc/hosts.tmp /etc/hosts 2>/dev/null || cat /etc/hosts.tmp > /etc/hosts

# 2. facebook.com hissəsini tənzimləyirik
if grep -q "facebook.com" /etc/hosts; then
    sed 's/.*facebook.com/8.8.8.8 facebook.com/g' /etc/hosts > /etc/hosts.tmp
    cat /etc/hosts.tmp > /etc/hosts
else
    echo "8.8.8.8 facebook.com" >> /etc/hosts
fi

# Müvəqqəti faylı təmizləyirik
rm -f /etc/hosts.tmp
