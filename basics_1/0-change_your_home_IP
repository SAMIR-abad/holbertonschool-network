#!/usr/bin/env bash
# Configures an Ubuntu server so that:
#   - localhost resolves to 127.0.0.2
#   - facebook.com resolves to 8.8.8.8

# Update localhost entry: replace 127.0.0.1 with 127.0.0.2
sed -i 's/^127\.0\.0\.1\s\+localhost/127.0.0.2\tlocalhost/' /etc/hosts

# Add or update facebook.com entry
if grep -qP '^\S+\s+facebook\.com' /etc/hosts; then
    sed -i 's/^\S\+\s\+facebook\.com.*/8.8.8.8\tfacebook.com/' /etc/hosts
else
    echo -e "8.8.8.8\tfacebook.com" >> /etc/hosts
fi
