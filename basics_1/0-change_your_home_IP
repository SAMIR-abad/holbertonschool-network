#!/usr/bin/env bash
# Ubuntu serverində localhost və facebook.com domenlərinin IP ünvanlarını dəyişir

# 1. localhost-u 127.0.0.1-dən 127.0.0.2-yə dəyişirik
sed -i 's/127.0.0.1\tlocalhost/127.0.0.2\tlocalhost/g' /etc/hosts
sed -i 's/127.0.0.1 localhost/127.0.0.2 localhost/g' /etc/hosts

# 2. facebook.com domenini 8.8.8.8 IP-sinə yönləndiririk
# Əgər əvvəldən faylda varsa yeniləyirik, yoxdursa sonuna əlavə edirik
if grep -q "facebook.com" /etc/hosts; then
    sed -i 's/.*facebook.com/8.8.8.8 facebook.com/g' /etc/hosts
else
    echo "8.8.8.8 facebook.com" >> /etc/hosts
fi
